:root {
    --primary: #10b981;
    --primary-dark: #059669;
    --bg-color: #0f172a;
    --card-bg: #1e293b;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: var(--bg-color);
    color: var(--text-main);
    line-height: 1.6;
}

header {
    background: linear-gradient(135deg, #064e3b 0%, var(--bg-color) 100%);
    padding: 4rem 2rem;
    text-align: center;
    border-bottom: 1px solid #334155;
}

header h1 {
    font-size: 2.75rem;
    margin-bottom: 1rem;
    color: var(--text-main);
}

header h1 span {
    color: var(--primary);
}

header p {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
}

main {
    max-width: 1000px;
    margin: 3rem auto;
    padding: 0 1.5rem;
}

.section-title {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    border-left: 4px solid var(--primary);
    padding-left: 0.75rem;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
}

.card {
    background-color: var(--card-bg);
    border-radius: 8px;
    padding: 2rem;
    border: 1px solid #334155;
    transition: transform 0.2s, border-color 0.2s;
}

.card:hover {
    transform: translateY(-3px);
    border-color: var(--primary);
}

.card h3 {
    margin-bottom: 0.75rem;
    color: var(--primary);
    font-size: 1.25rem;
}

.card p {
    color: var(--text-muted);
    font-size: 0.95rem;
}

footer {
    text-align: center;
    padding: 2rem;
    border-top: 1px solid #334155;
    color: var(--text-muted);
    font-size: 0.9rem;
}
